{
  "name": "bedrock-118-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft 基岩版 1.18 复刻（Web / WebGL2）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "gen:stats": "esbuild tools/gen-stats.ts --bundle --platform=node --format=esm --outfile=.tmp/gen-stats.mjs --log-level=error && node .tmp/gen-stats.mjs",
    "test:inventory": "esbuild tools/inventory-test.ts --bundle --platform=node --format=esm --outfile=.tmp/inventory-test.mjs --log-level=error && node .tmp/inventory-test.mjs",
    "test:crafting": "esbuild tools/crafting-test.ts --bundle --platform=node --format=esm --outfile=.tmp/crafting-test.mjs --log-level=error && node .tmp/crafting-test.mjs",
    "test:furnace": "esbuild tools/furnace-test.ts --bundle --platform=node --format=esm --outfile=.tmp/furnace-test.mjs --log-level=error && node .tmp/furnace-test.mjs",
    "test:entity": "esbuild tools/entity-test.ts --bundle --platform=node --format=esm --outfile=.tmp/entity-test.mjs --log-level=error && node .tmp/entity-test.mjs",
    "test:shapes": "esbuild tools/shapes-test.ts --bundle --platform=node --format=esm --outfile=.tmp/shapes-test.mjs --log-level=error && node .tmp/shapes-test.mjs",
    "test:biome": "esbuild tools/biome-test.ts --bundle --platform=node --format=esm --outfile=.tmp/biome-test.mjs --log-level=error && node .tmp/biome-test.mjs",
    "test:aquifer": "esbuild tools/aquifer-test.ts --bundle --platform=node --format=esm --outfile=.tmp/aquifer-test.mjs --log-level=error && node .tmp/aquifer-test.mjs",
    "test:ore": "esbuild tools/ore-test.ts --bundle --platform=node --format=esm --outfile=.tmp/ore-test.mjs --log-level=error && node .tmp/ore-test.mjs",
    "test": "npm run test:inventory && npm run test:crafting && npm run test:furnace && npm run test:entity && npm run test:shapes && npm run test:biome && npm run test:aquifer && npm run test:ore"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
