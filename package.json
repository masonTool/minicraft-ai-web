{
  "name": "bedrock-118-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft 基岩版 1.18 复刻（Web / WebGL2）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "gen:stats": "esbuild tools/gen-stats.ts --bundle --platform=node --format=esm --outfile=.tmp/gen-stats.mjs --log-level=error && node .tmp/gen-stats.mjs",
    "test:inventory": "esbuild tools/inventory-test.ts --bundle --platform=node --format=esm --outfile=.tmp/inventory-test.mjs --log-level=error && node .tmp/inventory-test.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
