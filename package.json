{
  "name": "bedrock-118-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft 基岩版 1.18 复刻（Web / WebGL2）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "gen:stats": "esbuild tools/gen-stats.ts --bundle --platform=node --format=esm --outfile=.tmp/gen-stats.mjs --log-level=error && node .tmp/gen-stats.mjs",
    "test:inventory": "esbuild tools/inventory-test.ts --bundle --platform=node --format=esm --outfile=.tmp/inventory-test.mjs --log-level=error && node .tmp/inventory-test.mjs",
    "test:crafting": "esbuild tools/crafting-test.ts --bundle --platform=node --format=esm --outfile=.tmp/crafting-test.mjs --log-level=error && node .tmp/crafting-test.mjs",
    "test:furnace": "esbuild tools/furnace-test.ts --bundle --platform=node --format=esm --outfile=.tmp/furnace-test.mjs --log-level=error && node .tmp/furnace-test.mjs",
    "test:entity": "esbuild tools/entity-test.ts --bundle --platform=node --format=esm --outfile=.tmp/entity-test.mjs --log-level=error && node .tmp/entity-test.mjs",
    "test:shapes": "esbuild tools/shapes-test.ts --bundle --platform=node --format=esm --outfile=.tmp/shapes-test.mjs --log-level=error && node .tmp/shapes-test.mjs",
    "test:biome": "esbuild tools/biome-test.ts --bundle --platform=node --format=esm --outfile=.tmp/biome-test.mjs --log-level=error && node .tmp/biome-test.mjs",
    "test:aquifer": "esbuild tools/aquifer-test.ts --bundle --platform=node --format=esm --outfile=.tmp/aquifer-test.mjs --log-level=error && node .tmp/aquifer-test.mjs",
    "test:ore": "esbuild tools/ore-test.ts --bundle --platform=node --format=esm --outfile=.tmp/ore-test.mjs --log-level=error && node .tmp/ore-test.mjs",
    "test:mesh": "esbuild tools/mesh-test.ts --bundle --platform=node --format=esm --outfile=.tmp/mesh-test.mjs --log-level=error && node .tmp/mesh-test.mjs",
    "test:survival": "esbuild tools/survival-test.ts --bundle --platform=node --format=esm --outfile=.tmp/survival-test.mjs --log-level=error && node .tmp/survival-test.mjs",
    "test:mob": "esbuild tools/mob-test.ts --bundle --platform=node --format=esm --outfile=.tmp/mob-test.mjs --log-level=error && node .tmp/mob-test.mjs",
    "test:spawn": "esbuild tools/spawn-test.ts --bundle --platform=node --format=esm --outfile=.tmp/spawn-test.mjs --log-level=error && node .tmp/spawn-test.mjs",
    "test:combat": "esbuild tools/combat-test.ts --bundle --platform=node --format=esm --outfile=.tmp/combat-test.mjs --log-level=error && node .tmp/combat-test.mjs",
    "test:decor": "esbuild tools/decor-test.ts --bundle --platform=node --format=esm --outfile=.tmp/decor-test.mjs --log-level=error && node .tmp/decor-test.mjs",
    "test:structure": "esbuild tools/structure-test.ts --bundle --platform=node --format=esm --outfile=.tmp/structure-test.mjs --log-level=error && node .tmp/structure-test.mjs",
    "test:nether": "esbuild tools/nether-test.ts --bundle --platform=node --format=esm --outfile=.tmp/nether-test.mjs --log-level=error && node .tmp/nether-test.mjs",
    "test:end": "esbuild tools/end-test.ts --bundle --platform=node --format=esm --outfile=.tmp/end-test.mjs --log-level=error && node .tmp/end-test.mjs",
    "test:endboss": "esbuild tools/end-boss-test.ts --bundle --platform=node --format=esm --outfile=.tmp/end-boss-test.mjs --log-level=error && node .tmp/end-boss-test.mjs",
    "test:redstone": "esbuild tools/redstone-test.ts --bundle --platform=node --format=esm --outfile=.tmp/redstone-test.mjs --log-level=error && node .tmp/redstone-test.mjs",
    "test:save": "esbuild tools/save-test.ts --bundle --platform=node --format=esm --outfile=.tmp/save-test.mjs --log-level=error && node .tmp/save-test.mjs",
    "test": "npm run test:unit && npm run test:inventory && npm run test:crafting && npm run test:furnace && npm run test:entity && npm run test:shapes && npm run test:biome && npm run test:aquifer && npm run test:ore && npm run test:mesh && npm run test:survival && npm run test:mob && npm run test:spawn && npm run test:combat && npm run test:decor && npm run test:structure && npm run test:audio && npm run test:nether && npm run test:end && npm run test:endboss && npm run test:redstone && npm run test:save && npm run test:net && npm run test:render",
    "server": "node server/index.mjs",
    "test:render": "esbuild tools/render-test.ts --bundle --platform=node --format=esm --outfile=.tmp/render-test.mjs --log-level=error && node .tmp/render-test.mjs",
    "test:net": "node tools/net-test.mjs",
    "test:audio": "esbuild tools/audio-test.ts --bundle --platform=node --format=esm --outfile=.tmp/audio-test.mjs --log-level=error && node .tmp/audio-test.mjs",
    "test:unit": "vitest run tests",
    "test:unit:watch": "vitest tests"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
