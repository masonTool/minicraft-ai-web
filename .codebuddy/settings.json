{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codebuddy/hooks/auto-continue.mjs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .codebuddy/hooks/auto-commit.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codebuddy/hooks/auto-continue.mjs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .codebuddy/hooks/auto-commit.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
