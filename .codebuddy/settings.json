{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .continue/hooks/run.mjs auto-continue.mjs --event=Stop",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .continue/hooks/run.mjs auto-commit.mjs --event=Stop",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "node .continue/hooks/run.mjs dispatch.mjs --event=Stop",
            "timeout": 60
          }
        ],
        "loop_limit": 100
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .continue/hooks/run.mjs queue-init.mjs --event=UserPromptSubmit",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .continue/hooks/run.mjs auto-continue.mjs --event=UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
