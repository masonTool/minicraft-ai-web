node_modules/
dist/
dist-ssr/
*.local
.DS_Store
*.log
npm-debug.log*
.vite/
coverage/
.idea/
.vscode/*
!.vscode/extensions.json
.playwright-cli/
.tmp/

# —— AI 钩子的运行时产物：日志、计数状态、刹车开关 ——
# 位置：.continue/logs/（日志 + 状态，另有 .continue/.gitignore 兜底）、.continue/*.off（刹车）。
# 这些文件每轮都会变，进仓库只会把 git status 撑爆、让 auto-commit 误判成"有改动"。
.continue/logs/
.continue/*.off
.continue/*.state.json
# 旧位置（2026-10-22 迁移到 continue-do 之前留下的，防止漏网）
.codebuddy/
.codebuddy/hooks/logs/
.codebuddy/*.off
.codebuddy/*.state.json
.codebuddy/logs/
.codebuddy/process/
.codebuddy/auto-continue.log
.codebuddy/auto-continue.state.json
.codebuddy/auto-commit.log
.codebuddy/auto-commit.state.json

# —— WorkBuddy 的工作区记忆（每日日志，本地性质，不进仓库）——
# 与 .codebuddy/memory/（人工整理的版本化副本）分开：那是一份结论，这是每日流水
.workbuddy/

# —— 本地安装的技能包（每个会话按需加载，跨机器各自安）——
.codebuddy/skills/*
# 例外：continue-task 是本仓库机制补丁的**源**，必须跟代码一起版本化——
# 否则重装会用旧模板覆盖 `.continue/hooks/`，本批的 5 个钩子修复就丢了。
!.codebuddy/skills/continue-task/

# —— 进仓库的（显式列出，防止上面规则误伤）——
# .continue/queues/           会话级队列
# .continue/archive/          旧队列与批次流水（只读历史）
# .continue/hooks/*.mjs       钩子脚本
# .continue/{TASKS,DONE,HANDOFF}.md + batch-seq + config.json
# .codebuddy/memory/          AI 记忆的版本化副本
# .codebuddy/settings.json    钩子注册

shot-*.png

# 参考资料（本地存档的网页 / 截图；4.7MB 的 mhtml 进仓库会永久留在历史里）
references/
